# ---- Base de datos (Neon Postgres) ----
# Formato SQLAlchemy. Reemplaza USUARIO, CLAVE, HOST y BASE con los de Neon.
DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@HOST/BASE?sslmode=require&channel_binding=require
# "public" o vacío para usar el schema público compartido con la API .NET
DB_SCHEMA=public

# ---- Imágenes: "s3" (bucket Neon) o "local" (carpeta data/imagenes) ----
IMAGE_STORAGE=s3
S3_BUCKET=assets
S3_PREFIX=nutrihabit/productos
S3_ADDRESSING_STYLE=path
AWS_ENDPOINT_URL_S3=https://TU-ENDPOINT.storage.c-6.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# ---- API ----
# Clave para el endpoint POST /scrape/{tienda}. Genera una larga y aleatoria.
API_KEY=
# Pausa (segundos) entre peticiones a los sitios
SCRAPE_DELAY=1.5
